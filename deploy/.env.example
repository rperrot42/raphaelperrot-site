# Copie ce fichier en deploy/.env et renseigne tes identifiants.
# deploy/.env est ignoré par git : il ne partira jamais sur GitHub.
#
# Où les trouver : espace client OVH → Hébergements → ton hébergement
# → onglet « FTP - SSH ». Le mot de passe se réinitialise depuis cette page.

OVH_HOST=ftp.cluster129.hosting.ovh.net
OVH_USER=raphaqm
OVH_PASSWORD=

# Dossier servi par l'hébergement. C'est /www chez OVH, sauf multisite.
OVH_REMOTE_DIR=www

# sftp = port 22, chiffré ; l'offre gratuite OVH refuse le FTP+TLS
# sftp = plus simple et plus sûr, mais réservé aux offres Pro et Performance
OVH_PROTOCOL=sftp
