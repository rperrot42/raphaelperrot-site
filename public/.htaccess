# Configuration Apache pour un hébergement mutualisé OVH.
# Ce fichier est copié tel quel dans dist/ par Vite : il doit se retrouver
# à la racine de /www sur le serveur, à côté de index.html.

# ─────────────────────────────────────────────────────────────
# Forcer le HTTPS et le domaine sans www
# ─────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # OVH place le protocole d'origine dans cet en-tête derrière son proxy.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Application monopage : toute URL qui ne correspond pas à un fichier
  # réel est servie par index.html (c'est ce qui fait marcher /mentions-legales).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ─────────────────────────────────────────────────────────────
# En-têtes de sécurité
# ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS : force le navigateur à n'utiliser que HTTPS pendant un an.
  # ⚠️ À n'activer (retirer le #) QU'UNE FOIS le certificat SSL actif et
  # https://raphaelperrot.com vérifié. Activé trop tôt, les visiteurs se
  # retrouvent bloqués sur une version HTTPS qui ne répond pas encore.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Les fichiers versionnés par Vite (assets/) et les polices ne changent
  # jamais sous le même nom : on les met en cache un an.
  <FilesMatch "\.(woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html ne doit jamais être mis en cache, sinon une mise en ligne
  # continue de servir l'ancienne version pendant des heures.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ─────────────────────────────────────────────────────────────
# Compression
# ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # Les .woff2 sont déjà compressés : les recompresser ne ferait que
  # consommer du CPU pour rien.
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# Pages d'erreur : l'application gère l'affichage côté client.
ErrorDocument 404 /index.html

# Ne pas lister le contenu des dossiers
Options -Indexes
